---
import { ui, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<main>
  <p class="label">{t.label}</p>
  <h1>{t.heading}</h1>
  <p class="sub">{t.sub}</p>
  <p class="soon">{t.soon}</p>
  <div class="switch"><LanguageSwitcher lang={lang} /></div>
</main>

<style>
  main { max-width: 760px; margin: 0 auto; padding: var(--space-8) var(--gutter); }
  .label { margin: 0 0 var(--space-5); font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; color: var(--color-accent); }
  h1 { margin: 0; font-size: clamp(38px, 10vw, 80px); line-height: 1.03; letter-spacing: -.035em; }
  .sub { margin: var(--space-5) 0 0; font-size: 18px; color: var(--color-text-2); }
  .soon { margin: var(--space-7) 0 0; color: var(--color-text-3); font-family: var(--font-mono); font-size: 13px; }
  .switch { margin-top: var(--space-5); }
</style>