---
// Icônes des services : traits fins arrondis, couleur = couleur du texte (currentColor)
type Name = 'tutoring' | 'computing' | 'training' | 'iot';
interface Props { name: Name; size?: number }
const { name, size = 40 } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'tutoring' && (
    <>
      <path d="M12 6.5C10.5 5 8 4.5 4 4.5v13c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-13c-4 0-6.5.5-8 2z" />
      <path d="M12 6.5v13" />
    </>
  )}
  {name === 'computing' && (
    <>
      <rect x="5" y="5" width="14" height="10" rx="2" />
      <path d="M2.5 19h19" />
    </>
  )}
  {name === 'training' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="3" />
      <path d="M7.5 10l3 2.5-3 2.5" />
      <path d="M13 15h4" />
    </>
  )}
  {name === 'iot' && (
    <>
      <path d="M5 9.5a10 10 0 0 1 14 0" />
      <path d="M8 12.5a6 6 0 0 1 8 0" />
      <circle cx="12" cy="16" r="1.4" fill="currentColor" stroke="none" />
      <rect x="6" y="18.5" width="12" height="3" rx="1.5" />
    </>
  )}
</svg>